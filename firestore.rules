rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function permissionExists(noteId, uid) {
      return exists(/databases/$(database)/documents/projectPermissions/$(noteId + '_' + uid));
    }

    function permission(noteId, uid) {
      return get(/databases/$(database)/documents/projectPermissions/$(noteId + '_' + uid)).data;
    }

    function isOwner(noteId) {
      return signedIn()
        && get(/databases/$(database)/documents/notes/$(noteId)).data.ownerId == request.auth.uid;
    }

    function hasRole(noteId, roles) {
      return signedIn() && permissionExists(noteId, request.auth.uid)
        && (permission(noteId, request.auth.uid).get('role', '') in roles
          || permission(noteId, request.auth.uid).get('permission', '') in roles);
    }

    function canRead(noteId) {
      let note = get(/databases/$(database)/documents/notes/$(noteId)).data;
      let projectId = note.get('projectId', null);
      return signedIn() && (note.get('ownerId', '') == request.auth.uid
        || (note.get('collaborators', []) is list && request.auth.uid in note.get('collaborators', []))
        || permissionExists(noteId, request.auth.uid)
        || (projectId is string && projectId != noteId && projectMember(projectId)));
    }

    function projectMember(projectId) {
      return isProjectUser(projectId, request.auth.uid);
    }

    function isProjectUser(projectId, uid) {
      let project = get(/databases/$(database)/documents/notes/$(projectId)).data;
      return signedIn() && (project.get('ownerId', '') == uid
        || (project.get('collaborators', []) is list && uid in project.get('collaborators', []))
        || permissionExists(projectId, uid));
    }

    function projectEditor(projectId) {
      let project = get(/databases/$(database)/documents/notes/$(projectId)).data;
      return signedIn() && (project.get('ownerId', '') == request.auth.uid
        || hasRole(projectId, ['admin', 'editor'])
        || (project.get('activityType', '') == 'group' && hasRole(projectId, ['student']))
        || (project.get('collaborators', []) is list && request.auth.uid in project.get('collaborators', [])
          && !permissionExists(projectId, request.auth.uid)));
    }

    function canEdit(noteId) {
      let note = get(/databases/$(database)/documents/notes/$(noteId)).data;
      return signedIn() && (note.get('ownerId', '') == request.auth.uid
        || hasRole(noteId, ['admin', 'editor'])
        || (note.get('activityType', '') == 'group' && hasRole(noteId, ['student']))
        || (note.get('collaborators', []) is list && request.auth.uid in note.get('collaborators', [])
          && !permissionExists(noteId, request.auth.uid))
        || (note.get('projectId', null) is string && note.get('projectId', null) != noteId
          && projectEditor(note.get('projectId', null))));
    }

    function canAdmin(noteId) {
      return isOwner(noteId) || hasRole(noteId, ['admin']);
    }

    function canJoinCollaborators(noteId) {
      let currentMembers = resource.data.get('collaborators', []);
      let nextMembers = request.resource.data.get('collaborators', []);
      return signedIn() && hasRole(noteId, ['viewer', 'student', 'editor', 'admin'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators'])
        && nextMembers is list && nextMembers.hasAll(currentMembers)
        && !(request.auth.uid in currentMembers)
        && request.auth.uid in nextMembers
        && nextMembers.size() == currentMembers.size() + 1;
    }

    match /notes/{noteId} {
      allow get: if canRead(noteId);
      allow list: if signedIn() && (resource.data.get('ownerId', '') == request.auth.uid
        || (resource.data.get('collaborators', []) is list && request.auth.uid in resource.data.get('collaborators', []))
        || permissionExists(noteId, request.auth.uid)
        || (resource.data.get('projectId', null) is string
          && projectMember(resource.data.get('projectId', null))));
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.get('projectId', null) == null
          || projectEditor(request.resource.data.get('projectId', null)));
      allow update: if (canAdmin(noteId) && request.resource.data.ownerId == resource.data.ownerId)
        || (canEdit(noteId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'content', 'deltaContent', 'searchText', 'checkpoint', 'checkpointAt',
            'updatedAt', 'lastUpdatedByPlatform', 'properties', 'parentId', 'order'
          ]))
        || canJoinCollaborators(noteId);
      allow delete: if isOwner(noteId);

      match /updates/{updateId} {
        allow read, create, update, delete: if canEdit(noteId);
      }
      match /versions/{versionId} {
        allow read: if canRead(noteId);
        allow create, update, delete: if canEdit(noteId);
      }
      match /comments/{commentId} {
        allow read: if canRead(noteId);
        allow create, update, delete: if canEdit(noteId);
      }
      match /presence/{presenceId} {
        allow read: if canRead(noteId);
        allow create, update: if canRead(noteId)
          && presenceId == request.auth.uid;
        allow delete: if canRead(noteId) && presenceId == request.auth.uid;
      }
      match /instructions/{instructionId} {
        allow read: if canRead(noteId);
        allow write: if canAdmin(noteId);
      }
      match /activities/{activityId} {
        allow read: if canRead(noteId);
        allow create, update, delete: if canAdmin(noteId);

        match /completions/{userId} {
          allow read: if canAdmin(noteId)
            || (signedIn() && request.auth.uid == userId && hasRole(noteId, ['student']));
          allow create, update: if signedIn() && request.auth.uid == userId
            && hasRole(noteId, ['student']);
          allow delete: if canAdmin(noteId);
        }
      }
      match /studentWorkspaces/{studentId} {
        allow read: if canAdmin(noteId)
          || (signedIn() && request.auth.uid == studentId && hasRole(noteId, ['student']));
        allow create, update: if signedIn() && request.auth.uid == studentId
          && hasRole(noteId, ['student']);
        allow delete: if canAdmin(noteId)
          || (signedIn() && request.auth.uid == studentId && hasRole(noteId, ['student']));

        match /{collectionName}/{documentId} {
          allow read: if canAdmin(noteId)
            || (signedIn() && request.auth.uid == studentId && hasRole(noteId, ['student']));
          allow create, update: if signedIn() && request.auth.uid == studentId
            && hasRole(noteId, ['student']);
          allow delete: if canAdmin(noteId)
            || (signedIn() && request.auth.uid == studentId && hasRole(noteId, ['student']));

          match /updates/{updateId} {
            allow read: if canAdmin(noteId)
              || (signedIn() && request.auth.uid == studentId && hasRole(noteId, ['student']));
            allow create: if signedIn() && request.auth.uid == studentId
              && hasRole(noteId, ['student'])
              && request.resource.data.authorId == request.auth.uid;
            allow update, delete: if canAdmin(noteId)
              || (signedIn() && request.auth.uid == studentId
                && hasRole(noteId, ['student']) && resource.data.authorId == request.auth.uid);
          }
        }
      }
    }

    match /shareLinks/{token} {
      // The unguessable token is used for a single-document lookup during acceptance.
      allow get: if signedIn() && token.size() >= 24;
      allow list: if signedIn() && (resource.data.createdBy == request.auth.uid
        || canAdmin(resource.data.projectId));
      allow create: if signedIn() && token.size() >= 24
        && request.resource.data.createdBy == request.auth.uid
        && canAdmin(request.resource.data.projectId)
        && request.resource.data.permission in ['editor', 'viewer', 'student', 'admin'];
      allow update: if signedIn()
        && (resource.data.createdBy == request.auth.uid || canAdmin(resource.data.projectId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'expiresAt']);
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || canAdmin(resource.data.projectId));
    }

    match /projectPermissions/{permId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid
        || canRead(resource.data.projectId));
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.grantedByToken is string
        && exists(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken))
        && get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.projectId == request.resource.data.projectId
        && get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.isActive == true
        && (get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.expiresAt == null
          || request.time.toMillis() < get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.expiresAt)
        && request.resource.data.keys().hasOnly([
          'projectId', 'userId', 'role', 'permission', 'grantedAt', 'grantedByToken'
        ])
        && ((request.resource.data.keys().hasAny(['role'])
              && !request.resource.data.keys().hasAny(['permission'])
              && request.resource.data.role == get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.permission)
          || (request.resource.data.keys().hasAny(['permission'])
              && !request.resource.data.keys().hasAny(['role'])
              && request.resource.data.permission == get(/databases/$(database)/documents/shareLinks/$(request.resource.data.grantedByToken)).data.permission));
      allow update, delete: if signedIn() && canAdmin(resource.data.projectId);
    }

    function validUserRoleOnCreate() {
      return !('role' in request.resource.data)
        || request.resource.data.role == null
        || request.resource.data.role in ['student', 'instructor'];
    }

    function validUserRoleOnUpdate() {
      let oldRole = resource.data.get('role', null);
      let hasNewRole = 'role' in request.resource.data;
      let newRole = request.resource.data.get('role', null);
      return oldRole == null
        ? (!hasNewRole || newRole == null || newRole in ['student', 'instructor'])
        : hasNewRole && newRole == oldRole;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && validUserRoleOnCreate();
      allow update: if signedIn() && request.auth.uid == userId
        && validUserRoleOnUpdate();
      // A person may delete only their own profile document (account deletion from Profile settings).
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /notifications/{userId}/items/{itemId} {
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.resource.data.fromUser.uid == request.auth.uid
        && request.resource.data.get('projectId', null) is string
        && isProjectUser(request.resource.data.projectId, request.auth.uid)
        && isProjectUser(request.resource.data.projectId, userId);
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid
        || canAdmin(resource.data.projectId));
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.projectId is string
        && hasRole(request.resource.data.projectId, ['student']);
      allow update: if signedIn() && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentName', 'submittedAt', 'status', 'components'
        ])
        || (signedIn() && canAdmin(resource.data.projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'feedback', 'score', 'gradedAt', 'status'
          ]));
      allow delete: if signedIn() && canAdmin(resource.data.projectId);
    }

    function quizSignedIn() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    function isInstructor() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'instructor';
    }

    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'student';
    }

    function isClassOwner(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    function isActiveMember(classId) {
      let enrollmentPath = /databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid);
      return signedIn() && exists(enrollmentPath) && get(enrollmentPath).data.status == 'active';
    }

    function validJoinCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function validClassColor(color) {
      return color in ['navy', 'ocean', 'teal', 'green', 'amber', 'rust', 'crimson', 'rose', 'purple', 'indigo', 'slate'];
    }

    function validClass(data) {
      return data.keys().hasOnly(['ownerId', 'ownerName', 'name', 'section', 'subject', 'description', 'joinCode', 'joinEnabled', 'requireApproval', 'status', 'accent', 'color', 'createdAt', 'updatedAt', 'codeRotatedAt'])
        && data.keys().hasAll(['ownerId', 'ownerName', 'name', 'section', 'subject', 'description', 'joinCode', 'joinEnabled', 'requireApproval', 'status', 'accent', 'createdAt', 'updatedAt', 'codeRotatedAt'])
        && (!('color' in data) || validClassColor(data.color))
        && data.ownerId is string && data.ownerName is string && data.name is string && data.name.size() > 0
        && data.section is string && data.subject is string && data.description is string
        && validJoinCode(data.joinCode) && data.joinEnabled is bool && data.requireApproval is bool
        && data.status in ['active', 'archived'] && data.accent in ['pinstripe', 'stripeFade', 'solid']
        && data.createdAt is timestamp && data.updatedAt is timestamp && data.codeRotatedAt is timestamp;
    }

    function validClassCode(data, code) {
      return data.keys().hasOnly(['classId', 'ownerId', 'className', 'ownerName', 'joinEnabled', 'requireApproval', 'archived'])
        && data.keys().hasAll(['classId', 'ownerId', 'className', 'ownerName', 'joinEnabled', 'requireApproval', 'archived'])
        && validJoinCode(code) && data.classId is string && data.ownerId == request.auth.uid
        && data.className is string && data.ownerName is string && data.joinEnabled is bool
        && data.requireApproval is bool && data.archived is bool;
    }

    function classCodeMatchesClass(data, code, classId) {
      let classPath = /databases/$(database)/documents/classes/$(classId);
      return existsAfter(classPath)
        && getAfter(classPath).data.ownerId == request.auth.uid
        && getAfter(classPath).data.joinCode == code
        && data.classId == classId
        && data.className == getAfter(classPath).data.name
        && data.ownerName == getAfter(classPath).data.ownerName
        && data.joinEnabled == getAfter(classPath).data.joinEnabled
        && data.requireApproval == getAfter(classPath).data.requireApproval
        && data.archived == (getAfter(classPath).data.status == 'archived');
    }

    match /classes/{classId} {
      allow get, list: if signedIn() && (resource.data.ownerId == request.auth.uid || isActiveMember(classId));
      allow create: if isInstructor()
        && request.resource.data.ownerId == request.auth.uid
        && validClass(request.resource.data)
        && existsAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode))
        && classCodeMatchesClass(getAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data, request.resource.data.joinCode, classId);
      allow update: if isClassOwner(classId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validClass(request.resource.data)
        && existsAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode))
        && classCodeMatchesClass(getAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data, request.resource.data.joinCode, classId);
      allow delete: if isClassOwner(classId);

      match /modules/{moduleId} {
        function validModule(data) {
          return data.keys().hasOnly(['ownerId', 'title', 'description', 'order', 'status', 'quizIds', 'resourceCount', 'createdAt', 'updatedAt', 'publishedAt'])
            && data.keys().hasAll(['ownerId', 'title', 'description', 'order', 'status', 'quizIds', 'resourceCount', 'createdAt', 'updatedAt', 'publishedAt'])
            && data.ownerId is string && data.title is string && data.title.size() > 0 && data.title.size() <= 120
            && data.description is string && data.description.size() <= 1000 && data.order is number
            && data.status in ['draft', 'published'] && data.quizIds is list && data.quizIds.size() <= 10
            && data.resourceCount is int && data.resourceCount >= 0 && data.resourceCount <= 10
            && data.createdAt is timestamp && data.updatedAt is timestamp
            && (data.publishedAt == null || data.publishedAt is timestamp);
        }
        function owner() { return isClassOwner(classId) && resource.data.ownerId == request.auth.uid; }
        allow get, list: if isClassOwner(classId) || (isActiveMember(classId) && resource.data.status == 'published');
        allow create: if isClassOwner(classId) && request.resource.data.ownerId == request.auth.uid && validModule(request.resource.data);
        allow update: if isClassOwner(classId) && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt && validModule(request.resource.data);
        allow delete: if isClassOwner(classId);

        match /resources/{resourceId} {
          function parentPath() { return /databases/$(database)/documents/classes/$(classId)/modules/$(moduleId); }
          function resourceOwner() { return isClassOwner(classId) && exists(parentPath()) && get(parentPath()).data.ownerId == request.auth.uid; }
          function resourceOwnerAfter() { return isClassOwner(classId) && existsAfter(parentPath()) && getAfter(parentPath()).data.ownerId == request.auth.uid; }
          function resourceCountWithinLimit() {
            return existsAfter(parentPath())
              && getAfter(parentPath()).data.get('resourceCount', -1) is int
              && getAfter(parentPath()).data.get('resourceCount', -1) <= 10;
          }
          function validResourceCreateCount(data) {
            let countAfter = getAfter(parentPath()).data.get('resourceCount', -1);
            return existsAfter(parentPath()) && countAfter is int && countAfter > 0 && countAfter <= 10
              && data.order is int && data.order >= 0 && data.order < countAfter
              && (!exists(parentPath()) || (countAfter > get(parentPath()).data.get('resourceCount', 0)
                && data.order >= get(parentPath()).data.get('resourceCount', 0)));
          }
          function validResource(data) {
            return data.keys().hasOnly(['type', 'title', 'order', 'url', 'driveFileId', 'driveKind', 'youtubeVideoId', 'body', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['type', 'title', 'order', 'createdAt', 'updatedAt'])
              && data.type in ['drive', 'youtube', 'link', 'text'] && data.title is string && data.title.size() > 0 && data.title.size() <= 120
              && data.order is number && data.createdAt is timestamp && data.updatedAt is timestamp
              && (data.type == 'text' ? data.get('body', null) is string && data.get('body', '').size() <= 5000
                : data.get('url', null) is string && data.get('url', '').size() <= 2000
                  && ((data.type == 'link' && data.get('url', '').matches('^https://[^ ]+$'))
                    || (data.type == 'drive' && data.get('url', '').matches('^https://(drive|docs)\\.google\\.com/.*'))
                    || (data.type == 'youtube' && data.get('url', '').matches('^https://(www\\.)?(youtube\\.com|youtu\\.be|youtube-nocookie\\.com)/.*'))))
              && (data.type != 'drive' || (data.get('driveFileId', null) is string && data.get('driveKind', null) in ['file', 'doc', 'sheet', 'slides']))
              && (data.type != 'youtube' || data.get('youtubeVideoId', null) is string);
          }
          allow get, list: if resourceOwner() || (isActiveMember(classId) && get(parentPath()).data.status == 'published');
          allow create: if resourceOwnerAfter() && validResource(request.resource.data)
            && resourceCountWithinLimit() && validResourceCreateCount(request.resource.data);
          allow update: if resourceOwner() && validResource(request.resource.data) && resourceCountWithinLimit();
          allow delete: if resourceOwner() && resourceCountWithinLimit();
        }
      }

      match /learningCanvases/{canvasId} {
        function validLearningCanvas(data) {
          return data.keys().hasOnly(['ownerId', 'classId', 'kind', 'title', 'description', 'status', 'nodeCount', 'edgeCount', 'refs', 'sourceCanvasId', 'createdAt', 'updatedAt'])
            && data.keys().hasAll(['ownerId', 'classId', 'kind', 'title', 'description', 'status', 'nodeCount', 'edgeCount', 'refs', 'createdAt', 'updatedAt'])
            && data.ownerId is string
            && data.classId == classId
            && data.kind in ['class', 'personal']
            && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
            && data.description is string && data.description.size() <= 300
            && (data.kind == 'class'
              ? data.status in ['draft', 'published']
              : data.status == 'private')
            && data.nodeCount is int && data.nodeCount >= 0 && data.nodeCount <= 80
            && data.edgeCount is int && data.edgeCount >= 0 && data.edgeCount <= 120
            && data.refs is list && data.refs.size() <= 80
            && (!('sourceCanvasId' in data) || data.sourceCanvasId == null || data.sourceCanvasId is string)
            && data.createdAt is timestamp && data.updatedAt is timestamp;
        }

        // ---- Sharing (collaboration) helpers -------------------------------------------
        // Invited people live in members/{uid}. They must still belong to the class, so
        // removing a student from the class also removes their access to shared canvases.
        function canvasPath() {
          return /databases/$(database)/documents/classes/$(classId)/learningCanvases/$(canvasId);
        }
        function memberPath(uid) {
          return /databases/$(database)/documents/classes/$(classId)/learningCanvases/$(canvasId)/members/$(uid);
        }
        function invitePath(token) {
          return /databases/$(database)/documents/classes/$(classId)/learningCanvases/$(canvasId)/invites/$(token);
        }
        function isCanvasOwner() {
          return signedIn() && exists(canvasPath()) && get(canvasPath()).data.ownerId == request.auth.uid;
        }
        function stillInClass() {
          return isClassOwner(classId) || isActiveMember(classId);
        }
        function memberRole() {
          return exists(memberPath(request.auth.uid)) ? get(memberPath(request.auth.uid)).data.get('role', '') : '';
        }
        function isCanvasMember() {
          return signedIn() && stillInClass() && memberRole() in ['viewer', 'editor'];
        }
        function isCanvasEditor() {
          return signedIn() && stillInClass() && memberRole() == 'editor';
        }

        allow get: if signedIn() && (
          resource == null
          || (resource.data.get('kind', '') == 'class' && (isClassOwner(classId) || (isActiveMember(classId) && resource.data.get('status', '') == 'published')))
          || (resource.data.get('kind', '') == 'personal' && resource.data.get('ownerId', '') == request.auth.uid)
          || isCanvasMember()
        );
        allow list: if signedIn() && (
          isClassOwner(classId)
          || (resource.data.get('kind', '') == 'class' && isActiveMember(classId) && resource.data.get('status', '') == 'published')
          || (resource.data.get('kind', '') == 'personal' && resource.data.get('ownerId', '') == request.auth.uid)
        );

        allow create: if signedIn()
          && validLearningCanvas(request.resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && (
            (request.resource.data.kind == 'class' && isClassOwner(classId))
            || (request.resource.data.kind == 'personal' && isActiveMember(classId))
          );

        allow update: if signedIn()
          && validLearningCanvas(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.kind == 'class' && isClassOwner(classId))
            || (resource.data.kind == 'personal' && resource.data.ownerId == request.auth.uid)
            // An invited editor may only refresh the derived counters when saving the board.
            || (isCanvasEditor()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nodeCount', 'edgeCount', 'refs', 'updatedAt']))
          );

        allow delete: if signedIn() && (
          (resource.data.kind == 'class' && isClassOwner(classId))
          || (resource.data.kind == 'personal' && (resource.data.ownerId == request.auth.uid || isClassOwner(classId)))
        );

        match /content/{contentId} {
          function parentPath() {
            return /databases/$(database)/documents/classes/$(classId)/learningCanvases/$(canvasId);
          }
          function parentExists() {
            return exists(parentPath()) || existsAfter(parentPath());
          }
          function parentCanvas() {
            return exists(parentPath()) ? get(parentPath()).data : getAfter(parentPath()).data;
          }

          function validContent(data) {
            return contentId == 'main'
              && data.keys().hasOnly(['version', 'nodes', 'edges', 'viewport'])
              && data.keys().hasAll(['version', 'nodes', 'edges', 'viewport'])
              && data.version == 1
              && data.nodes is list && data.nodes.size() <= 80
              && data.edges is list && data.edges.size() <= 120
              && data.viewport is map
              && data.viewport.keys().hasOnly(['x', 'y', 'zoom'])
              && data.viewport.keys().hasAll(['x', 'y', 'zoom'])
              && data.viewport.x is number
              && data.viewport.y is number
              && data.viewport.zoom is number;
          }

          allow get: if signedIn() && (
            resource == null
            || (exists(parentPath()) && (
              (get(parentPath()).data.kind == 'class' && (isClassOwner(classId) || (isActiveMember(classId) && get(parentPath()).data.status == 'published')))
              || (get(parentPath()).data.kind == 'personal' && get(parentPath()).data.ownerId == request.auth.uid)
              || isCanvasMember()
            ))
          );

          allow list: if signedIn()
            && exists(parentPath()) && (
              (get(parentPath()).data.kind == 'class' && (isClassOwner(classId) || (isActiveMember(classId) && get(parentPath()).data.status == 'published')))
              || (get(parentPath()).data.kind == 'personal' && get(parentPath()).data.ownerId == request.auth.uid)
              || isCanvasMember()
            );

          allow create, update: if signedIn()
            && parentExists()
            && validContent(request.resource.data)
            && (
              (parentCanvas().kind == 'class' && isClassOwner(classId))
              || (parentCanvas().kind == 'personal' && parentCanvas().ownerId == request.auth.uid)
              || isCanvasEditor()
            );

          allow delete: if signedIn() && (
            isClassOwner(classId)
            || (exists(parentPath()) && (
              (get(parentPath()).data.kind == 'class' && isClassOwner(classId))
              || (get(parentPath()).data.kind == 'personal' && get(parentPath()).data.ownerId == request.auth.uid)
            ))
          );
        }

        // Who was invited and what they may do. Only the canvas owner changes a role; a member
        // can never edit or remove their own record, so a downgrade cannot be undone by re-joining.
        match /members/{memberUid} {
          function validMember(data) {
            let invite = get(invitePath(data.grantedByToken)).data;
            return data.keys().hasOnly(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
              && data.keys().hasAll(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
              && data.uid == memberUid
              && data.role in ['viewer', 'editor']
              && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
              && data.invitedBy is string
              && data.grantedByToken is string
              && data.joinedAt == request.time && data.updatedAt == request.time
              && exists(invitePath(data.grantedByToken))
              && invite.active == true
              && (invite.expiresAt == null || request.time < invite.expiresAt)
              && data.role == invite.role
              && data.invitedBy == invite.createdBy;
          }

          allow get: if signedIn() && (memberUid == request.auth.uid || isCanvasOwner() || isCanvasMember());
          allow list: if signedIn() && (isCanvasOwner() || isCanvasMember());
          allow create: if signedIn()
            && memberUid == request.auth.uid
            && exists(canvasPath())
            && !isCanvasOwner()
            && stillInClass()
            && validMember(request.resource.data);
          allow update: if isCanvasOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
            && request.resource.data.role in ['viewer', 'editor']
            && request.resource.data.updatedAt == request.time;
          allow delete: if isCanvasOwner() || isClassOwner(classId);
        }

        // Invite links. The token is the document id, so it cannot be listed or guessed.
        match /invites/{token} {
          function validInvite(data) {
            return data.keys().hasOnly(['createdBy', 'code', 'role', 'active', 'createdAt', 'expiresAt'])
              && data.keys().hasAll(['createdBy', 'role', 'active', 'createdAt', 'expiresAt'])
              && data.createdBy == request.auth.uid
              && (!('code' in data) || (data.code is string && data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')))
              && data.role in ['viewer', 'editor']
              && data.active is bool
              && data.createdAt == request.time
              && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time));
          }

          allow get: if signedIn() && token.size() >= 32;
          allow list: if isCanvasOwner();
          allow create: if isCanvasOwner() && token.size() >= 32 && validInvite(request.resource.data);
          allow update: if isCanvasOwner()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
            && request.resource.data.active is bool;
          allow delete: if isCanvasOwner() || isClassOwner(classId);
        }

        // One heartbeat document per person: online flag, last-active time and pointer position.
        match /presence/{presenceUid} {
          function validPresence(data) {
            return data.keys().hasOnly(['uid', 'name', 'online', 'cursor', 'lastActive'])
              && data.keys().hasAll(['uid', 'name', 'online', 'cursor', 'lastActive'])
              && data.uid == request.auth.uid
              && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
              && data.online is bool
              && data.lastActive == request.time
              && (data.cursor == null || (data.cursor is map
                && data.cursor.keys().hasOnly(['x', 'y'])
                && data.cursor.x is number && data.cursor.y is number
                && data.cursor.x >= -100000 && data.cursor.x <= 100000
                && data.cursor.y >= -100000 && data.cursor.y <= 100000));
          }

          allow get, list: if signedIn() && (isCanvasOwner() || isCanvasMember());
          allow create, update: if signedIn()
            && presenceUid == request.auth.uid
            && (isCanvasOwner() || isCanvasMember())
            && validPresence(request.resource.data);
          allow delete: if signedIn() && (presenceUid == request.auth.uid || isCanvasOwner() || isClassOwner(classId));
        }

        // Append-only log of who changed what. Entries cannot be edited, so the history is trustworthy.
        match /activity/{activityId} {
          function validActivity(data) {
            return data.keys().hasOnly(['actorId', 'actorName', 'type', 'summary', 'changes', 'createdAt'])
              && data.keys().hasAll(['actorId', 'actorName', 'type', 'summary', 'changes', 'createdAt'])
              && data.actorId == request.auth.uid
              && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
              && data.type in ['edit', 'member']
              && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
              && data.changes is list && data.changes.size() <= 20
              && data.createdAt == request.time;
          }

          allow get, list: if signedIn() && (isCanvasOwner() || isCanvasMember());
          allow create: if signedIn()
            && validActivity(request.resource.data)
            && (
              (request.resource.data.type == 'edit' && (isCanvasOwner() || isCanvasEditor()))
              || (request.resource.data.type == 'member' && (isCanvasOwner() || isCanvasMember()))
            );
          allow update: if false;
          allow delete: if isCanvasOwner() || isClassOwner(classId);
        }
      }
    }

    // Individually shared graph views are separate saved snapshots, not class-wide shares.
    match /classes/{classId}/graphViews/{graphId} {
      function graphPath() {
        return /databases/$(database)/documents/classes/$(classId)/graphViews/$(graphId);
      }
      function graphMemberPath(uid) {
        return /databases/$(database)/documents/classes/$(classId)/graphViews/$(graphId)/members/$(uid);
      }
      function graphInvitePath(token) {
        return /databases/$(database)/documents/classes/$(classId)/graphViews/$(graphId)/invites/$(token);
      }
      function graphOwner() {
        return signedIn() && exists(graphPath()) && get(graphPath()).data.ownerId == request.auth.uid;
      }
      function graphRole() {
        return signedIn() && exists(graphMemberPath(request.auth.uid))
          ? get(graphMemberPath(request.auth.uid)).data.get('role', '')
          : '';
      }
      function graphMember() {
        return signedIn() && exists(graphPath()) && graphRole() in ['viewer', 'editor'];
      }
      function graphEditor() {
        return graphMember() && graphRole() == 'editor';
      }
      function validGraphConfig(data) {
        return data.keys().hasOnly(['ownerId', 'ownerName', 'classId', 'title', 'nodeIds', 'positions', 'nodes', 'links', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['ownerId', 'ownerName', 'classId', 'title', 'nodeIds', 'positions', 'createdAt', 'updatedAt'])
          && data.ownerId is string
          && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
          && data.classId == classId
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
          && data.nodeIds is list && data.nodeIds.size() <= 80
          && data.positions is map && data.positions.size() <= 80
          && data.get('nodes', []) is list && data.get('nodes', []).size() <= 80
          && data.get('links', []) is list && data.get('links', []).size() <= 120
          && data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      allow get: if signedIn() && (resource == null || graphOwner() || graphMember());
      allow list: if graphOwner();
      allow create: if signedIn()
        && validGraphConfig(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && (isClassOwner(classId) || isActiveMember(classId));
      allow update: if signedIn()
        && validGraphConfig(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          graphOwner()
          || (graphEditor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nodeIds', 'positions', 'nodes', 'links', 'updatedAt']))
        );
      allow delete: if graphOwner();

      match /invites/{token} {
        function validGraphInvite(data) {
          return data.keys().hasOnly(['createdBy', 'code', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.keys().hasAll(['createdBy', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.createdBy == request.auth.uid
            && (!('code' in data) || (data.code is string && data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')))
            && data.role in ['viewer', 'editor']
            && data.active is bool
            && data.createdAt == request.time
            && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time));
        }
        allow get: if signedIn() && exists(graphPath());
        allow list: if graphOwner();
        allow create: if graphOwner() && validGraphInvite(request.resource.data);
        allow update: if graphOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
        allow delete: if graphOwner();
      }

      match /members/{memberUid} {
        function validGraphMember(data) {
          let invite = get(graphInvitePath(data.grantedByToken)).data;
          return data.keys().hasOnly(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
            && data.keys().hasAll(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
            && data.uid == memberUid
            && data.role in ['viewer', 'editor']
            && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
            && data.invitedBy is string
            && data.grantedByToken is string
            && data.joinedAt == request.time && data.updatedAt == request.time
            && exists(graphInvitePath(data.grantedByToken))
            && invite.active == true
            && (invite.expiresAt == null || request.time < invite.expiresAt)
            && data.role == invite.role
            && data.invitedBy == invite.createdBy;
        }
        allow get: if signedIn() && (graphOwner() || graphMember() || memberUid == request.auth.uid);
        allow list: if graphOwner() || graphMember();
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && exists(graphPath())
          && !graphOwner()
          && validGraphMember(request.resource.data);
        allow update: if graphOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.updatedAt == request.time;
        allow delete: if graphOwner();
      }

      match /activity/{activityId} {
        function validGraphActivity(data) {
          return data.keys().hasOnly(['actorId', 'actorName', 'type', 'summary', 'changes', 'createdAt'])
            && data.keys().hasAll(['actorId', 'actorName', 'type', 'summary', 'changes', 'createdAt'])
            && data.actorId == request.auth.uid
            && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
            && data.type in ['edit', 'member']
            && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
            && data.changes is list && data.changes.size() <= 10
            && data.createdAt == request.time;
        }
        allow get, list: if graphOwner() || graphMember();
        allow create: if signedIn()
          && validGraphActivity(request.resource.data)
          && (
            (request.resource.data.type == 'edit' && (graphOwner() || graphEditor()))
            || (request.resource.data.type == 'member' && graphOwner())
          );
        allow update, delete: if false;
      }

      match /presence/{uid} {
        function validGraphPresence(data) {
          return data.keys().hasOnly(['uid', 'name', 'online', 'lastActive'])
            && data.keys().hasAll(['uid', 'name', 'online', 'lastActive'])
            && data.uid == request.auth.uid
            && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
            && data.online is bool
            && data.lastActive == request.time;
        }
        allow get, list: if graphOwner() || graphMember();
        allow create, update: if signedIn() && uid == request.auth.uid
          && validGraphPresence(request.resource.data)
          && (graphOwner() || graphMember());
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }

    match /classes/{classId}/flashcardDecks/{deckId} {
      function deckPath() {
        return /databases/$(database)/documents/classes/$(classId)/flashcardDecks/$(deckId);
      }
      function deckMemberPath(uid) {
        return /databases/$(database)/documents/classes/$(classId)/flashcardDecks/$(deckId)/members/$(uid);
      }
      function deckInvitePath(token) {
        return /databases/$(database)/documents/classes/$(classId)/flashcardDecks/$(deckId)/invites/$(token);
      }
      function isDeckOwner() {
        return signedIn() && exists(deckPath()) && get(deckPath()).data.ownerId == request.auth.uid;
      }
      function deckMemberRole() {
        return exists(deckMemberPath(request.auth.uid))
          ? get(deckMemberPath(request.auth.uid)).data.get('role', '')
          : '';
      }
      function isDeckMember() {
        return signedIn() && exists(deckPath()) && (isClassOwner(classId) || isActiveMember(classId))
          && deckMemberRole() in ['viewer', 'editor'];
      }
      function isDeckEditor() {
        return signedIn() && (isClassOwner(classId) || isActiveMember(classId))
          && deckMemberRole() == 'editor';
      }

      function validFlashcardDeck(data) {
        return data.keys().hasOnly(['ownerId', 'classId', 'kind', 'title', 'description', 'status', 'cardCount', 'cards', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['ownerId', 'classId', 'kind', 'title', 'description', 'status', 'cardCount', 'cards', 'createdAt', 'updatedAt'])
          && data.ownerId is string
          && data.classId == classId
          && data.kind in ['class', 'personal']
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 300
          && (data.kind == 'class'
            ? data.status in ['draft', 'published']
            : data.status == 'private')
          && data.cards is list && data.cards.size() >= 1 && data.cards.size() <= 100
          && data.cardCount is int && data.cardCount == data.cards.size()
          && data.createdAt is timestamp && data.updatedAt is timestamp;
      }

      allow get: if signedIn() && (
        resource == null
        || (resource.data.get('kind', '') == 'class' && (isClassOwner(classId) || (isActiveMember(classId) && resource.data.get('status', '') == 'published')))
        || (resource.data.get('kind', '') == 'personal' && resource.data.get('ownerId', '') == request.auth.uid)
        || isDeckMember()
      );
      allow list: if signedIn() && (
        isClassOwner(classId)
        || (resource.data.get('kind', '') == 'class' && isActiveMember(classId) && resource.data.get('status', '') == 'published')
        || (resource.data.get('kind', '') == 'personal' && resource.data.get('ownerId', '') == request.auth.uid)
        || isDeckMember()
      );

      allow create: if signedIn()
        && validFlashcardDeck(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && (
          (request.resource.data.kind == 'class' && isClassOwner(classId))
          || (request.resource.data.kind == 'personal' && isActiveMember(classId))
        );

      allow update: if signedIn()
        && validFlashcardDeck(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.kind == 'class' && isClassOwner(classId))
          || (resource.data.kind == 'personal' && resource.data.ownerId == request.auth.uid)
          || (isDeckEditor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'cardCount', 'cards', 'updatedAt'
            ]))
        );

      allow delete: if signedIn() && (
        (resource.data.kind == 'class' && isClassOwner(classId))
        || (resource.data.kind == 'personal' && (resource.data.ownerId == request.auth.uid || isClassOwner(classId)))
      );

      match /members/{memberUid} {
        function validDeckMember(data) {
          let invite = get(deckInvitePath(data.grantedByToken)).data;
          return data.keys().hasOnly(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
            && data.keys().hasAll(['uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'])
            && data.uid == memberUid
            && data.role in ['viewer', 'editor']
            && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
            && data.invitedBy is string
            && data.grantedByToken is string
            && data.joinedAt == request.time && data.updatedAt == request.time
            && exists(deckInvitePath(data.grantedByToken))
            && invite.active == true
            && (invite.expiresAt == null || request.time < invite.expiresAt)
            && data.role == invite.role
            && data.invitedBy == invite.createdBy;
        }

        allow get: if signedIn() && (memberUid == request.auth.uid || isDeckOwner() || isDeckMember());
        allow list: if signedIn() && (isDeckOwner() || isDeckMember());
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && exists(deckPath())
          && !isDeckOwner()
          && (isClassOwner(classId) || isActiveMember(classId))
          && validDeckMember(request.resource.data);
        allow update: if isDeckOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.updatedAt == request.time;
        allow delete: if isDeckOwner() || isClassOwner(classId);
      }

      match /invites/{token} {
        function validDeckInvite(data) {
          return data.keys().hasOnly(['createdBy', 'code', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.keys().hasAll(['createdBy', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.createdBy == request.auth.uid
            && (!('code' in data) || (data.code is string && data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')))
            && data.role in ['viewer', 'editor']
            && data.active is bool
            && data.createdAt == request.time
            && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time));
        }

        allow get: if signedIn() && exists(deckPath()) && token.size() >= 32
          && (isClassOwner(classId) || isActiveMember(classId));
        allow list: if isDeckOwner();
        allow create: if isDeckOwner() && token.size() >= 32 && validDeckInvite(request.resource.data);
        allow update: if isDeckOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
        allow delete: if isDeckOwner() || isClassOwner(classId);
      }

      match /activity/{activityId} {
        function validDeckActivity(data) {
          return data.keys().hasOnly(['actorId', 'actorName', 'type', 'summary', 'createdAt'])
            && data.keys().hasAll(['actorId', 'actorName', 'type', 'summary', 'createdAt'])
            && data.actorId == request.auth.uid
            && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80
            && data.type in ['edit', 'member']
            && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200
            && data.createdAt == request.time;
        }
        allow get, list: if signedIn() && (isDeckOwner() || isDeckMember());
        allow create: if signedIn() && validDeckActivity(request.resource.data)
          && ((request.resource.data.type == 'edit' && (isDeckOwner() || isDeckEditor()))
            || (request.resource.data.type == 'member' && isDeckOwner()));
        allow update: if false;
        allow delete: if isDeckOwner() || isClassOwner(classId);
      }

      match /presence/{uid} {
        function validDeckPresence(data) {
          return data.keys().hasOnly(['uid', 'name', 'online', 'lastActive'])
            && data.keys().hasAll(['uid', 'name', 'online', 'lastActive'])
            && data.uid == request.auth.uid
            && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
            && data.online is bool
            && data.lastActive == request.time;
        }
        allow get, list: if signedIn() && (isDeckOwner() || isDeckMember());
        allow create, update: if signedIn() && uid == request.auth.uid
          && validDeckPresence(request.resource.data)
          && (isDeckOwner() || isDeckMember());
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }

    // "Shared with me": a person finds the canvases they were invited to by querying their own member records.
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /classCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isInstructor()
        && validClassCode(request.resource.data, code)
        && classCodeMatchesClass(request.resource.data, code, request.resource.data.classId);
      allow update: if isInstructor()
        && resource.data.ownerId == request.auth.uid
        && resource.data.classId == request.resource.data.classId
        && validClassCode(request.resource.data, code)
        && classCodeMatchesClass(request.resource.data, code, request.resource.data.classId);
      allow delete: if isInstructor() && resource.data.ownerId == request.auth.uid;
    }

    match /enrollments/{enrollmentId} {
      allow get: if signedIn()
        && ((!exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
            && enrollmentId.matches('^.+_' + request.auth.uid + '$'))
          || resource.data.uid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && enrollmentId == request.resource.data.classId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
        && request.resource.data.keys().hasOnly(['classId', 'ownerId', 'uid', 'studentName', 'studentPhotoURL', 'className', 'status', 'codeUsed', 'joinedAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['classId', 'ownerId', 'uid', 'studentName', 'studentPhotoURL', 'className', 'status', 'codeUsed', 'joinedAt', 'updatedAt'])
        && request.resource.data.classId is string && request.resource.data.ownerId is string
        && request.resource.data.studentName is string && request.resource.data.studentName.size() > 0 && request.resource.data.studentName.size() <= 120
        && (request.resource.data.studentPhotoURL == null || (request.resource.data.studentPhotoURL is string && request.resource.data.studentPhotoURL.size() <= 2000))
        && request.resource.data.className is string && validJoinCode(request.resource.data.codeUsed)
        && request.resource.data.joinedAt is timestamp && request.resource.data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinCode == request.resource.data.codeUsed
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinEnabled == true
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status == 'active'
        && request.resource.data.status == (get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.requireApproval ? 'pending' : 'active');
      allow update: if isClassOwner(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'pending', 'blocked'];
      allow delete: if isClassOwner(resource.data.classId)
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status != 'blocked');
    }

    function quizOwner(quizId) {
      return quizSignedIn()
        && exists(/databases/$(database)/documents/quizzes/$(quizId))
        && get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == request.auth.uid;
    }

    function hasQuizRole(role) {
      return quizSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function quizPublished(quizId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      return exists(quizPath)
        && get(quizPath).data.status == 'published'
        && get(quizPath).data.get('classId', null) is string
        && isActiveMember(get(quizPath).data.classId);
    }

    function quizHasParticipant(quizId, uid) {
      return exists(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(uid));
    }

    function validQuizSettings(settings, mode) {
      return settings is map
        && settings.keys().hasOnly(['answerReveal', 'participation', 'scoreVisibility', 'scoresReleased', 'timeLimitMinutes', 'attemptsAllowed', 'shuffleQuestions', 'shuffleOptions'])
        && settings.keys().hasAll(['answerReveal', 'participation', 'scoreVisibility', 'scoresReleased', 'timeLimitMinutes', 'attemptsAllowed', 'shuffleQuestions', 'shuffleOptions'])
        && settings.answerReveal in ['after_each', 'after_submit', 'never']
        && settings.scoreVisibility in ['immediate', 'after_release', 'hidden']
        && settings.scoresReleased is bool
        && (settings.timeLimitMinutes == null || (settings.timeLimitMinutes is int && settings.timeLimitMinutes > 0))
        && (settings.attemptsAllowed == null || (settings.attemptsAllowed is int && settings.attemptsAllowed > 0))
        && settings.shuffleQuestions is bool
        && settings.shuffleOptions is bool
        && settings.participation is map
        && ((settings.participation.type == 'individual'
            && settings.participation.keys().hasOnly(['type'])
            && settings.participation.keys().hasAll(['type']))
          || (settings.participation.type == 'group'
            && settings.participation.keys().hasOnly(['type', 'groupSize'])
            && settings.participation.keys().hasAll(['type', 'groupSize'])
            && settings.participation.groupSize is int
            && settings.participation.groupSize >= 2
            && settings.participation.groupSize <= 10))
        && (mode != 'flashcards'
          || (settings.answerReveal == 'never' && settings.scoreVisibility == 'hidden' && settings.scoresReleased == false))
        && (mode != 'canvas'
          || (settings.participation.type == 'individual'
            && settings.shuffleQuestions == false
            && settings.shuffleOptions == false));
    }

    function validQuiz(data) {
      return data.keys().hasOnly(['ownerId', 'ownerName', 'classId', 'title', 'description', 'tags', 'mode', 'boardKind', 'status', 'questionCount', 'createdAt', 'updatedAt', 'publishedAt', 'settings'])
        && data.keys().hasAll(['ownerId', 'ownerName', 'title', 'description', 'tags', 'mode', 'status', 'questionCount', 'createdAt', 'updatedAt', 'publishedAt', 'settings'])
        && data.ownerId is string && data.ownerName is string
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.tags is list && data.tags.size() <= 20 && data.mode in ['quiz', 'flashcards', 'canvas']
        && (!data.keys().hasAny(['boardKind']) || (data.mode == 'canvas' && data.boardKind in ['prebuilt', 'blank']))
        && data.status in ['draft', 'published', 'archived']
        && (!data.keys().hasAny(['classId']) || data.classId is string)
        && data.questionCount is int && data.questionCount >= 0
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (data.publishedAt == null || data.publishedAt is timestamp)
        && validQuizSettings(data.settings, data.mode);
    }

    function validOptionItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'text'])
        && item.keys().hasAll(['id', 'text'])
        && item.id is string
        && item.text is string
        && item.text.size() <= 500;
    }

    function validOptionsList(options) {
      return validOptionItem(options[0])
        && validOptionItem(options[1])
        && (options.size() < 3 || validOptionItem(options[2]))
        && (options.size() < 4 || validOptionItem(options[3]))
        && (options.size() < 5 || validOptionItem(options[4]))
        && (options.size() < 6 || validOptionItem(options[5]));
    }

    function validQuestion(data) {
      return data.keys().hasOnly(['order', 'type', 'prompt', 'options', 'points'])
        && data.keys().hasAll(['order', 'type', 'prompt', 'points'])
        && data.order is int && data.order >= 0
        && data.type in ['multiple_choice', 'true_false', 'identification', 'fill_blank', 'flashcard']
        && data.prompt is string && data.prompt.size() <= 2000 && data.points is int && data.points > 0
        && ((data.type == 'multiple_choice' || data.type == 'true_false')
          ? data.keys().hasAll(['options']) && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
            && (data.type != 'true_false' || data.options.size() == 2)
            && validOptionsList(data.options)
          : !data.keys().hasAny(['options']));
    }

    function validCanvasQuestion(data) {
      return data.keys().hasOnly(['order', 'type', 'prompt', 'points', 'layoutMode', 'directed', 'wrongPenalty', 'cards'])
        && data.keys().hasAll(['order', 'type', 'prompt', 'points', 'layoutMode', 'directed', 'wrongPenalty', 'cards'])
        && data.order is int && data.order >= 0
        && data.type == 'canvas'
        && data.prompt is string && data.prompt.size() <= 2000
        && data.points is int && data.points >= 1 && data.points <= 1000
        && data.layoutMode in ['scattered', 'fixed']
        && data.directed is bool
        && data.wrongPenalty in ['none', 'half', 'full']
        && data.cards is list && data.cards.size() <= 50;
    }

    function validBlankCanvasQuestion(data) {
      return data.keys().hasOnly(['order', 'type', 'prompt', 'points', 'cards', 'rubric', 'showRubricToStudents', 'maxCards', 'maxConnections', 'allowedCardTypes', 'directed'])
        && data.keys().hasAll(['order', 'type', 'prompt', 'points', 'cards', 'showRubricToStudents', 'maxCards', 'maxConnections', 'allowedCardTypes'])
        && (!('directed' in data) || data.directed is bool)
        && data.order is int && data.order >= 0
        && data.type == 'canvas'
        && data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 2000
        && (!('rubric' in data) || (data.rubric is string && data.rubric.size() <= 1000))
        && data.showRubricToStudents is bool
        && data.points is int && data.points >= 1 && data.points <= 1000
        && data.maxCards is int && data.maxCards >= 1 && data.maxCards <= 30
        && data.maxConnections is int && data.maxConnections >= 0 && data.maxConnections <= 80
        && data.allowedCardTypes is list && data.allowedCardTypes.size() > 0
        && data.allowedCardTypes.hasOnly(['note', 'paragraph', 'link'])
        && data.cards is list && data.cards.size() == 0;
    }

    function validQuestionForQuiz(quizId, questionId, data) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      let quizDoc = existsAfter(quizPath) ? getAfter(quizPath).data : get(quizPath).data;
      let quizMode = quizDoc.mode;
      let isBlank = quizDoc.mode == 'canvas' && ('boardKind' in quizDoc && quizDoc.boardKind == 'blank');
      return (quizMode == 'canvas'
        ? questionId == 'board' && (isBlank ? validBlankCanvasQuestion(data) : validCanvasQuestion(data))
        : validQuestion(data));
    }

    function matchingAnswerKey(quizId, questionId, data) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      let quizDoc = existsAfter(quizPath) ? getAfter(quizPath).data : get(quizPath).data;
      let isBlankCanvas = quizDoc.mode == 'canvas' && ('boardKind' in quizDoc && quizDoc.boardKind == 'blank');
      let questionPath = /databases/$(database)/documents/quizzes/$(quizId)/questions/$(questionId);
      let questionType = existsAfter(questionPath) ? getAfter(questionPath).data.type : get(questionPath).data.type;
      return !isBlankCanvas
        && existsAfter(questionPath)
        && ((questionType in ['multiple_choice', 'true_false'] && data.type == 'choice')
          || (questionType == 'identification' && data.type == 'identification')
          || (questionType == 'fill_blank' && data.type == 'fill_blank')
          || (questionType == 'flashcard' && data.type == 'flashcard')
          || (questionType == 'canvas' && data.type == 'canvas' && questionId == 'board'));
    }

    function validAnswerKey(data) {
      return (data.type == 'canvas'
        ? data.keys().hasOnly(['type', 'explanation', 'connections'])
          && data.keys().hasAll(['type', 'explanation', 'connections'])
          && data.explanation is string && data.explanation.size() <= 2000
          && data.connections is list && data.connections.size() <= 80
        : data.keys().hasOnly(['type', 'correctOptionId', 'acceptedAnswers', 'blanks', 'back', 'explanation', 'caseSensitive'])
          && data.keys().hasAll(['type', 'explanation', 'caseSensitive'])
          && data.explanation is string && data.caseSensitive is bool
          && ((data.type == 'choice' && data.keys().hasOnly(['type', 'correctOptionId', 'explanation', 'caseSensitive']) && data.correctOptionId is string)
            || (data.type == 'identification' && data.keys().hasOnly(['type', 'acceptedAnswers', 'explanation', 'caseSensitive']) && data.acceptedAnswers is list && data.acceptedAnswers.size() > 0)
            || (data.type == 'fill_blank' && data.keys().hasOnly(['type', 'blanks', 'explanation', 'caseSensitive']) && data.blanks is list && data.blanks.size() > 0)
            || (data.type == 'flashcard' && data.keys().hasOnly(['type', 'back', 'explanation', 'caseSensitive']) && data.back is string)));
    }

    function validImage(data) {
      return data.keys().hasOnly(['data', 'mimeType', 'width', 'height', 'bytes', 'createdAt'])
        && data.keys().hasAll(['data', 'mimeType', 'width', 'height', 'bytes', 'createdAt'])
        && data.mimeType in ['image/jpeg', 'image/webp']
        && data.data is string && data.data.size() <= 700000
        && data.width is int && data.width >= 1 && data.width <= 2048
        && data.height is int && data.height >= 1 && data.height <= 2048
        && data.bytes is int && data.bytes >= 0
        && data.createdAt is timestamp;
    }

    function validBlankCard(card) {
      return card is map
        && card.keys().hasOnly(['id', 'type', 'content', 'title', 'url', 'position'])
        && card.keys().hasAll(['id', 'type', 'content', 'position'])
        && card.id is string && card.id.size() > 0 && card.id.size() <= 40
        && card.type in ['note', 'paragraph', 'link']
        && card.content is string && card.content.size() <= 1000
        && (!('title' in card) || (card.title is string && card.title.size() <= 120))
        && (card.type != 'link' || (!('url' in card) || card.url == '' || (card.url is string && card.url.size() <= 500 && card.url.matches('^https://[^\\s]+$'))))
        && card.position is map
        && card.position.keys().hasOnly(['x', 'y'])
        && card.position.keys().hasAll(['x', 'y'])
        && card.position.x is number && card.position.y is number;
    }

    function validBlankCardsList(cards) {
      return cards.size() == 0
        || (validBlankCard(cards[0])
          && (cards.size() < 2 || validBlankCard(cards[1]))
          && (cards.size() < 3 || validBlankCard(cards[2]))
          && (cards.size() < 4 || validBlankCard(cards[3]))
          && (cards.size() < 5 || validBlankCard(cards[4]))
          && (cards.size() < 6 || validBlankCard(cards[5]))
          && (cards.size() < 7 || validBlankCard(cards[6]))
          && (cards.size() < 8 || validBlankCard(cards[7]))
          && (cards.size() < 9 || validBlankCard(cards[8]))
          && (cards.size() < 10 || validBlankCard(cards[9])));
    }

    function validBlankConnection(conn) {
      return conn is string && conn.size() > 0 && conn.size() <= 100;
    }

    function validBlankConnectionsList(connections) {
      return connections.size() == 0
        || (validBlankConnection(connections[0])
          && (connections.size() < 2 || validBlankConnection(connections[1]))
          && (connections.size() < 3 || validBlankConnection(connections[2]))
          && (connections.size() < 4 || validBlankConnection(connections[3]))
          && (connections.size() < 5 || validBlankConnection(connections[4]))
          && (connections.size() < 6 || validBlankConnection(connections[5]))
          && (connections.size() < 7 || validBlankConnection(connections[6]))
          && (connections.size() < 8 || validBlankConnection(connections[7]))
          && (connections.size() < 9 || validBlankConnection(connections[8]))
          && (connections.size() < 10 || validBlankConnection(connections[9])));
    }

    function validBlankBoardAnswer(board) {
      return board is map
        && board.keys().hasOnly(['cards', 'connections'])
        && board.keys().hasAll(['cards', 'connections'])
        && board.cards is list && board.cards.size() <= 30
        && validBlankCardsList(board.cards)
        && board.connections is list && board.connections.size() <= 80
        && validBlankConnectionsList(board.connections);
    }

    function validAttempt(data, quizId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      let quizDoc = existsAfter(quizPath) ? getAfter(quizPath).data : get(quizPath).data;
      let isBlank = quizDoc.mode == 'canvas' && ('boardKind' in quizDoc && quizDoc.boardKind == 'blank');
      return data.keys().hasOnly(['userId', 'userName', 'attemptNumber', 'status', 'answers', 'questionOrder', 'optionOrder', 'startedAt', 'submittedAt', 'timeSpentSeconds'])
        && data.keys().hasAll(['userId', 'userName', 'attemptNumber', 'status', 'answers', 'questionOrder', 'optionOrder', 'startedAt', 'submittedAt', 'timeSpentSeconds'])
        && data.userId is string && data.userName is string
        && data.attemptNumber is int && data.attemptNumber > 0
        && data.status in ['in_progress', 'submitted']
        && data.answers is map && data.answers.size() <= 200
        && (isBlank
          ? data.answers.keys().hasOnly(['board'])
            && (!('board' in data.answers) || validBlankBoardAnswer(data.answers.board))
          : (!data.answers.keys().hasAny(['board']) || (data.answers.board is list && data.answers.board.size() <= 80))
            && (!data.answers.keys().hasAny(['layout']) || (data.answers.layout is list && data.answers.layout.size() <= 50)))
        && data.questionOrder is list && data.optionOrder is map
        && data.startedAt is timestamp
        && (data.submittedAt == null || data.submittedAt is timestamp)
        && data.timeSpentSeconds is int && data.timeSpentSeconds >= 0;
    }

    function validResult(data) {
      return data.keys().hasOnly(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt'])
        && data.keys().hasAll(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt'])
        && data.userId is string && data.score is number && data.score >= 0
        && data.maxScore is number && data.maxScore >= data.score
        && data.perQuestion is map && data.gradedAt is timestamp;
    }

    function validBlankStudentResult(data, quizId) {
      return data.keys().hasOnly(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt', 'reviewStatus'])
        && data.keys().hasAll(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt', 'reviewStatus'])
        && data.userId is string
        && data.score == 0
        && data.maxScore is number && data.maxScore >= 0
        && data.perQuestion is map
        && data.gradedAt is timestamp
        && data.reviewStatus == 'pending';
    }

    function validBlankOwnerResultUpdate(data, quizId, oldData) {
      let boardQuestion = get(/databases/$(database)/documents/quizzes/$(quizId)/questions/board).data;
      return data.keys().hasOnly(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt', 'reviewStatus', 'feedback', 'gradedBy'])
        && data.keys().hasAll(['userId', 'score', 'maxScore', 'perQuestion', 'gradedAt', 'reviewStatus'])
        && data.userId == oldData.userId
        && data.maxScore == oldData.maxScore
        && data.score is number && data.score >= 0 && data.score <= boardQuestion.points
        && data.reviewStatus in ['pending', 'graded']
        && (!('feedback' in data) || (data.feedback is string && data.feedback.size() <= 1000))
        && (!('gradedBy' in data) || data.gradedBy is string)
        && data.perQuestion is map
        && data.gradedAt is timestamp;
    }

    match /quizzes/{quizId} {
      allow get: if quizSignedIn()
        && (!exists(/databases/$(database)/documents/quizzes/$(quizId))
          || resource.data.ownerId == request.auth.uid
        || (isStudent() && resource.data.status == 'published'
          && resource.data.get('classId', null) is string && isActiveMember(resource.data.classId)));
      allow list: if quizSignedIn() && (resource.data.ownerId == request.auth.uid
        || (isStudent() && resource.data.status == 'published'
          && resource.data.get('classId', null) is string && isActiveMember(resource.data.classId)));
      allow create: if isInstructor()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.classId is string && isClassOwner(request.resource.data.classId)
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status == 'active'
        && request.resource.data.status == 'draft'
        && request.resource.data.questionCount == 0
        && validQuiz(request.resource.data);
      allow update: if quizOwner(quizId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.mode == resource.data.mode
        && (resource.data.mode != 'canvas' || (!('boardKind' in resource.data) && !('boardKind' in request.resource.data)) || (request.resource.data.get('boardKind', 'prebuilt') == resource.data.get('boardKind', 'prebuilt')))
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.get('classId', null) == resource.data.get('classId', null)
          || (resource.data.status == 'draft' && request.resource.data.get('classId', null) is string
            && isClassOwner(request.resource.data.classId)
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status == 'active'))
        && (request.resource.data.status != 'published'
          || (request.resource.data.title.size() > 0 && request.resource.data.questionCount > 0 && request.resource.data.publishedAt is timestamp
            && request.resource.data.get('classId', null) is string
            && isClassOwner(request.resource.data.classId)
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status == 'active'
            && (request.resource.data.mode != 'canvas' || request.resource.data.questionCount == 1)))
        && validQuiz(request.resource.data);
      allow delete: if quizOwner(quizId);

      match /questions/{questionId} {
        allow read: if quizOwner(quizId) || (isStudent() && quizPublished(quizId));
        allow create, update: if quizOwner(quizId)
          && validQuestionForQuiz(quizId, questionId, request.resource.data);
        allow delete: if quizOwner(quizId);
      }

      match /images/{imageId} {
        allow read: if quizOwner(quizId) || (isStudent() && quizPublished(quizId));
        allow create, update: if quizOwner(quizId) && validImage(request.resource.data);
        allow delete: if quizOwner(quizId);
      }

      match /answerKeys/{questionId} {
        allow read: if quizOwner(quizId)
          || (isStudent() && quizPublished(quizId) && quizHasParticipant(quizId, request.auth.uid));
        allow create, update: if quizOwner(quizId)
          && validAnswerKey(request.resource.data)
          && matchingAnswerKey(quizId, questionId, request.resource.data);
        allow delete: if quizOwner(quizId);
      }

      match /participants/{uid} {
        allow get: if quizOwner(quizId) || (isStudent() && request.auth.uid == uid && quizPublished(quizId));
        allow list: if quizOwner(quizId);
        allow create: if quizSignedIn() && request.auth.uid == uid
          && isStudent() && quizPublished(quizId)
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'createdAt', 'updatedAt', 'attemptCount', 'activeAttemptId'])
          && request.resource.data.keys().hasAll(['userId', 'userName', 'createdAt', 'updatedAt', 'attemptCount', 'activeAttemptId'])
          && request.resource.data.userId == uid
          && request.resource.data.userName is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.attemptCount == 1
          && request.resource.data.activeAttemptId is string
          && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId))
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId)).data.userId == uid
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId)).data.status == 'in_progress';
        allow update: if quizSignedIn() && request.auth.uid == uid && quizPublished(quizId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.attemptCount is int
          && ((resource.data.activeAttemptId == null
              && request.resource.data.activeAttemptId is string
              && request.resource.data.attemptCount == resource.data.attemptCount + 1
              && (get(/databases/$(database)/documents/quizzes/$(quizId)).data.settings.attemptsAllowed == null
                || request.resource.data.attemptCount <= get(/databases/$(database)/documents/quizzes/$(quizId)).data.settings.attemptsAllowed)
              && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId))
              && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId)).data.userId == uid
              && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(request.resource.data.activeAttemptId)).data.status == 'in_progress')
            || (request.resource.data.attemptCount == resource.data.attemptCount
              && request.resource.data.activeAttemptId == null
              && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(resource.data.activeAttemptId))
              && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(resource.data.activeAttemptId)).data.status == 'submitted'));
        allow delete: if quizOwner(quizId);
      }

      match /attempts/{attemptId} {
        allow get, list: if quizOwner(quizId) || (isStudent() && quizPublished(quizId) && resource.data.userId == request.auth.uid);
        allow create: if isStudent() && quizPublished(quizId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'in_progress'
          && request.resource.data.submittedAt == null
          && request.resource.data.startedAt == request.time
          && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(request.auth.uid)).data.activeAttemptId == attemptId
          && request.resource.data.attemptNumber == getAfter(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(request.auth.uid)).data.attemptCount
          && validAttempt(request.resource.data, quizId);
        allow update: if isStudent() && quizPublished(quizId) && resource.data.userId == request.auth.uid
          && resource.data.status == 'in_progress'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status in ['in_progress', 'submitted']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'submittedAt', 'timeSpentSeconds', 'optionOrder'])
          && validAttempt(request.resource.data, quizId)
          && (request.resource.data.status == 'in_progress' || request.resource.data.submittedAt == request.time)
          && (request.resource.data.status != 'submitted'
            || (existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/participants/$(request.auth.uid)).data.activeAttemptId == null
              && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/results/$(attemptId))));
        allow delete: if quizOwner(quizId);
      }

      match /results/{attemptId} {
        allow get, list: if quizOwner(quizId)
          || (isStudent() && quizPublished(quizId) && resource.data.userId == request.auth.uid
            && (get(/databases/$(database)/documents/quizzes/$(quizId)).data.settings.scoreVisibility == 'immediate'
              || (get(/databases/$(database)/documents/quizzes/$(quizId)).data.settings.scoreVisibility == 'after_release'
                && get(/databases/$(database)/documents/quizzes/$(quizId)).data.settings.scoresReleased == true)));
        allow create: if isStudent() && quizPublished(quizId)
          && request.resource.data.userId == request.auth.uid
          && (('boardKind' in get(/databases/$(database)/documents/quizzes/$(quizId)).data && get(/databases/$(database)/documents/quizzes/$(quizId)).data.boardKind == 'blank')
            ? validBlankStudentResult(request.resource.data, quizId)
            : validResult(request.resource.data))
          && exists(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(attemptId))
          && get(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(attemptId)).data.status == 'in_progress'
          && existsAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(attemptId))
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(attemptId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)/attempts/$(attemptId)).data.status == 'submitted';
        allow update: if quizOwner(quizId)
          && request.resource.data.userId == resource.data.userId
          && (('boardKind' in get(/databases/$(database)/documents/quizzes/$(quizId)).data && get(/databases/$(database)/documents/quizzes/$(quizId)).data.boardKind == 'blank')
            ? validBlankOwnerResultUpdate(request.resource.data, quizId, resource.data)
            : validResult(request.resource.data));
        allow delete: if quizOwner(quizId);
      }
    }

    // Collection-group discovery is intentionally limited to each recipient's own invite record.
    match /{path=**}/tutorMembers/{memberUid} {
      allow get: if signedIn() && memberUid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /learningInviteCodes/{code} {
      function validInviteCode(data) {
        return data.keys().hasOnly(['kind', 'classId', 'itemId', 'inviteToken', 'ownerId', 'createdAt', 'expiresAt'])
          && data.keys().hasAll(['kind', 'itemId', 'inviteToken', 'ownerId', 'createdAt', 'expiresAt'])
          && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')
          && data.kind in ['canvas', 'flashcard', 'graph', 'tutor']
          && data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 150
          && data.inviteToken is string && data.inviteToken.size() >= 32 && data.inviteToken.size() <= 64
          && data.ownerId == request.auth.uid
          && data.createdAt == request.time
          && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time))
          && (data.kind == 'tutor'
            ? !('classId' in data)
            : data.classId is string && data.classId.size() > 0 && data.classId.size() <= 150);
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validInviteCode(request.resource.data);
      allow update, delete: if false;
    }

    match /sharedTutorThreads/{threadId} {
      function threadPath() {
        return /databases/$(database)/documents/sharedTutorThreads/$(threadId);
      }
      function threadMemberPath(uid) {
        return /databases/$(database)/documents/sharedTutorThreads/$(threadId)/tutorMembers/$(uid);
      }
      function threadInvitePath(token) {
        return /databases/$(database)/documents/sharedTutorThreads/$(threadId)/invites/$(token);
      }
      function revokedInvitePath(uid, token) {
        return /databases/$(database)/documents/sharedTutorThreads/$(threadId)/revokedAccess/$(uid)/invites/$(token);
      }
      function isThreadOwner() {
        return signedIn() && exists(threadPath()) && get(threadPath()).data.ownerId == request.auth.uid;
      }
      function threadMemberRole() {
        return exists(threadMemberPath(request.auth.uid))
          ? get(threadMemberPath(request.auth.uid)).data.get('role', '')
          : '';
      }
      function isThreadMember() {
        return signedIn() && exists(threadPath()) && threadMemberRole() in ['viewer', 'editor'];
      }
      function canEditThread() {
        return isThreadOwner() || (signedIn() && threadMemberRole() == 'editor');
      }
      function canReadThread() {
        return isThreadOwner() || isThreadMember();
      }
      function validThread(data) {
        return data.keys().hasOnly([
            'ownerId', 'title', 'summary', 'summarizedCount', 'createdAtMs',
            'updatedAtMs', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasAll([
            'ownerId', 'title', 'summary', 'summarizedCount', 'createdAtMs',
            'updatedAtMs', 'createdAt', 'updatedAt'
          ])
          && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.summary is string && data.summary.size() <= 12000
          && data.summarizedCount is int && data.summarizedCount >= 0
          && data.createdAtMs is number && data.createdAtMs >= 0
          && data.updatedAtMs is number && data.updatedAtMs >= 0
          && data.createdAt is timestamp && data.updatedAt == request.time;
      }

      allow get: if signedIn() && (resource == null || canReadThread());
      allow list: if signedIn() && (resource.data.ownerId == request.auth.uid || isThreadMember());
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validThread(request.resource.data);
      allow update: if canEditThread()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'summary', 'summarizedCount', 'updatedAtMs', 'updatedAt'
        ])
        && validThread(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        function validImageMetadata(image) {
          return image is map
            && image.keys().hasOnly(['id', 'name', 'mimeType', 'width', 'height'])
            && image.keys().hasAll(['id', 'name', 'mimeType', 'width', 'height'])
            && image.id is string && image.id.size() > 0 && image.id.size() <= 128
            && image.name is string && image.name.size() <= 60
            && image.mimeType in ['image/jpeg', 'image/webp']
            && image.width is int && image.width > 0 && image.width <= 1024
            && image.height is int && image.height > 0 && image.height <= 1024;
        }
        function validMessage(data) {
          return data.keys().hasOnly(['id', 'role', 'text', 'createdAtMs', 'createdAt', 'failed', 'images'])
            && data.keys().hasAll(['id', 'role', 'text', 'createdAtMs', 'createdAt', 'images'])
            && data.id == messageId
            && data.role in ['user', 'assistant']
            && data.text is string && data.text.size() <= 50000
            && data.createdAtMs is number && data.createdAtMs >= 0
            && data.createdAt is timestamp
            && data.images is list && data.images.size() <= 2
            && (data.images.size() == 0 || validImageMetadata(data.images[0]))
            && (data.images.size() < 2 || validImageMetadata(data.images[1]))
            && (!('failed' in data) || data.failed == true);
        }
        allow get, list: if canReadThread();
        allow create: if canEditThread() && validMessage(request.resource.data);
        allow update: if canEditThread()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'failed', 'images'])
          && validMessage(request.resource.data);
        allow delete: if isThreadOwner();

        match /images/{imageId} {
          function validImage(data) {
            return data.keys().hasOnly(['id', 'data', 'mimeType', 'width', 'height', 'name'])
              && data.keys().hasAll(['id', 'data', 'mimeType', 'width', 'height', 'name'])
              && data.id == imageId
              && data.data is string && data.data.size() > 0 && data.data.size() <= 350000
              && data.data.matches('^[A-Za-z0-9+/]+={0,2}$')
              && data.mimeType in ['image/jpeg', 'image/webp']
              && data.width is int && data.width > 0 && data.width <= 1024
              && data.height is int && data.height > 0 && data.height <= 1024
              && data.name is string && data.name.size() <= 60;
          }
          allow get, list: if canReadThread();
          allow create: if canEditThread() && validImage(request.resource.data);
          allow update: if canEditThread()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'name'])
            && validImage(request.resource.data);
          allow delete: if isThreadOwner();
        }
      }

      match /tutorMembers/{memberUid} {
        function validAcceptedMember(data) {
          return data.keys().hasOnly([
              'uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'
            ])
            && data.keys().hasAll([
              'uid', 'role', 'displayName', 'invitedBy', 'grantedByToken', 'joinedAt', 'updatedAt'
            ])
            && data.uid == memberUid
            && data.role in ['viewer', 'editor']
            && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
            && data.invitedBy is string
            && data.grantedByToken is string
            && data.joinedAt == request.time && data.updatedAt == request.time
            && exists(threadInvitePath(data.grantedByToken))
            && get(threadInvitePath(data.grantedByToken)).data.active == true
            && (get(threadInvitePath(data.grantedByToken)).data.expiresAt == null
              || request.time < get(threadInvitePath(data.grantedByToken)).data.expiresAt)
            && data.role == get(threadInvitePath(data.grantedByToken)).data.role
            && data.invitedBy == get(threadInvitePath(data.grantedByToken)).data.createdBy
            && !exists(revokedInvitePath(memberUid, data.grantedByToken));
        }
        allow get: if signedIn() && (memberUid == request.auth.uid || isThreadOwner());
        allow list: if signedIn() && (isThreadOwner() || resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && exists(threadPath())
          && get(threadPath()).data.ownerId != request.auth.uid
          && validAcceptedMember(request.resource.data);
        allow update: if isThreadOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['viewer', 'editor']
          && request.resource.data.updatedAt == request.time;
        allow delete: if isThreadOwner();
      }

      match /invites/{inviteToken} {
        function validInvite(data) {
          return data.keys().hasOnly(['createdBy', 'code', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.keys().hasAll(['createdBy', 'role', 'active', 'createdAt', 'expiresAt'])
            && data.createdBy == request.auth.uid
            && (!('code' in data) || (data.code is string && data.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')))
            && data.role in ['viewer', 'editor']
            && data.active is bool
            && data.createdAt == request.time
            && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time));
        }
        allow get: if signedIn() && inviteToken.size() == 32;
        allow list: if isThreadOwner();
        allow create: if isThreadOwner() && inviteToken.size() == 32 && validInvite(request.resource.data);
        allow update: if isThreadOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
        allow delete: if isThreadOwner();
      }

      match /activity/{activityId} {
        function validActivity(data) {
          return data.keys().hasOnly(['actorId', 'actorName', 'summary', 'createdAt'])
            && data.keys().hasAll(['actorId', 'actorName', 'summary', 'createdAt'])
            && data.actorId == request.auth.uid
            && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 80
            && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 200
            && data.createdAt == request.time;
        }
        allow get, list: if canReadThread();
        allow create: if signedIn() && validActivity(request.resource.data)
          && (isThreadOwner() || (isThreadMember()
            && (threadMemberRole() == 'editor' || request.resource.data.summary == 'Joined the conversation.')));
        allow update: if false;
        allow delete: if isThreadOwner();
      }

      match /presence/{uid} {
        function validPresence(data) {
          return data.keys().hasOnly(['uid', 'name', 'online', 'lastActive'])
            && data.keys().hasAll(['uid', 'name', 'online', 'lastActive'])
            && data.uid == uid
            && data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && data.online is bool
            && data.lastActive == request.time;
        }
        allow get, list: if canReadThread();
        allow create, update: if signedIn() && uid == request.auth.uid
          && canReadThread() && validPresence(request.resource.data);
        allow delete: if signedIn() && (uid == request.auth.uid || isThreadOwner());
      }

      match /revokedAccess/{memberUid}/invites/{inviteToken} {
        allow get: if signedIn() && (isThreadOwner() || memberUid == request.auth.uid);
        allow list: if isThreadOwner();
        allow create: if isThreadOwner()
          && request.resource.data.keys().hasOnly(['uid', 'inviteToken', 'revokedBy', 'revokedAt'])
          && request.resource.data.keys().hasAll(['uid', 'inviteToken', 'revokedBy', 'revokedAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.inviteToken == inviteToken
          && request.resource.data.revokedBy == request.auth.uid
          && request.resource.data.revokedAt == request.time;
        allow update: if false;
        allow delete: if isThreadOwner();
      }
    }

    // Unknown paths are denied by default.
  }
}
