rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'instructor', null]
        && request.resource.data.createdAt is int;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (!("role" in resource.data) || resource.data.role == null)
            ? request.resource.data.role in ['student', 'instructor', null]
            : request.resource.data.role == resource.data.role
        );
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if owns(uid)
        && request.resource.data.name is string
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string);
      allow delete: if false;
    }
  }
}
