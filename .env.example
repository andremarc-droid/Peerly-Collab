VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false

# AI tutor (Groq). The key is required for the AI Tutor tab; the model is optional.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=qwen/qwen3.8-27b

# Assignments use Google Drive (picker + sharing). All three are required for the Assignments file features;
# the rest of the app works without them. Setup steps: docs/google-drive-setup.md
# VITE_GOOGLE_CLIENT_ID  = OAuth 2.0 Web client ID (Google Cloud > APIs & Services > Credentials)
# VITE_GOOGLE_API_KEY    = API key restricted to the Google Picker API and your site's referrers
# VITE_GOOGLE_APP_ID     = the Google Cloud project NUMBER (not the project id)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
